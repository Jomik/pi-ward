{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jomik/pi-ward/ward.schema.json",
  "title": "Ward Config",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern",
          "effect"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "description": "Path pattern to match. No prefix = unanchored segment match (e.g. `.env`, `*.pem`); `./` = anchored to the config directory; `~/` = anchored to the home directory; trailing `/` = directory match (the node itself and everything under it); `*` = wildcard matching one or more characters within a single segment.",
            "examples": [
              ".env",
              "*.pem",
              ".env*",
              ".secret/",
              "./",
              "./src/*.ts",
              "~/",
              "~/.ssh/",
              "~/.config/"
            ]
          },
          "operations": {
            "anyOf": [
              {
                "type": "string",
                "const": "read"
              },
              {
                "type": "string",
                "const": "write"
              }
            ]
          },
          "effect": {
            "anyOf": [
              {
                "type": "string",
                "const": "allow"
              },
              {
                "type": "string",
                "const": "deny"
              }
            ]
          }
        }
      }
    }
  }
}
